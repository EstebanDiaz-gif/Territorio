rules_version = '2';

// Reglas de seguridad de Territorio.
// Jerarquía: cabeza > encargado > dirigente > movilizador.
// Cada usuario y cada persona guarda "path": la lista de sus superiores (y del propio dueño).
// Ver o editar algo = estar en su path. Las cabezas ven toda la campaña.
// Los fiscales cuelgan de quien los cargó y solo pueden ver y cargar los datos de su mesa.

service cloud.firestore {
  match /databases/{database}/documents {

    // A qué campaña pertenece cada cuenta
    match /cuentas/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Invitación para alguien que ya tiene cuenta (de otra campaña). Se acepta al entrar con su DNI.
    match /invitaciones/{dni} {
      function gestorDe(c) {
        return exists(/databases/$(database)/documents/campanias/$(c)/usuarios/$(request.auth.uid))
          && get(/databases/$(database)/documents/campanias/$(c)/usuarios/$(request.auth.uid)).data.rol != 'fiscal';
      }
      function soyYo() { return request.auth != null && request.auth.token.email == dni + '@usuarios.territorio.app'; }
      allow read: if soyYo() || (request.auth != null && gestorDe(resource.data.cid));
      allow create, update: if request.auth != null
        && request.resource.data.dni == dni
        && request.resource.data.por == request.auth.uid
        && gestorDe(request.resource.data.cid)
        && (request.resource.data.rol != 'cabeza'
          || get(/databases/$(database)/documents/campanias/$(request.resource.data.cid)/usuarios/$(request.auth.uid)).data.rol == 'cabeza');
      allow delete: if soyYo() || (request.auth != null && gestorDe(resource.data.cid));
    }

    match /campanias/{cid} {
      function ruta(sub) { return path('/databases/' + database + '/documents/campanias/' + cid + sub); }
      function miembro() { return request.auth != null && exists(ruta('/usuarios/' + request.auth.uid)); }
      function yo() { return get(ruta('/usuarios/' + request.auth.uid)).data; }
      function esCabeza() { return miembro() && yo().rol == 'cabeza'; }
      function usuario(uid) { return get(ruta('/usuarios/' + uid)).data; }
      function nivel(r) {
        return r == 'cabeza' ? 0 : (r == 'encargado' ? 1 : (r == 'dirigente' ? 2 : (r == 'movilizador' ? 3 : 9)));
      }
      function enMiEquipo(p) { return request.auth.uid in p; }
      // Todos menos los fiscales
      function gestor() { return miembro() && yo().rol != 'fiscal'; }
      function soloCambia(campos) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
      }

      allow read: if miembro();
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if esCabeza() && soloCambia(['nombre', 'listas', 'categorias']);

      // ---------- Usuarios ----------
      match /usuarios/{uid} {
        allow read: if miembro() && (esCabeza() || enMiEquipo(resource.data.path));
        allow create: if request.auth != null && request.resource.data.uid == uid && (
          // la primera cabeza, al crear la campaña
          (uid == request.auth.uid
            && get(ruta('')).data.ownerUid == request.auth.uid
            && request.resource.data.rol == 'cabeza'
            && request.resource.data.path == [uid])
          // otra cabeza, creada por una cabeza
          || (esCabeza() && request.resource.data.rol == 'cabeza' && request.resource.data.path == [uid])
          // alguien un nivel debajo de su superior; lo crea ese superior, alguien por encima de él o una cabeza
          || (gestor()
            && nivel(request.resource.data.rol) == nivel(usuario(request.resource.data.parentId).rol) + 1
            && request.resource.data.path == usuario(request.resource.data.parentId).path.concat([uid])
            && (esCabeza() || enMiEquipo(usuario(request.resource.data.parentId).path)))
          // alguien que ya tenía cuenta y aceptó la invitación a esta campaña (se agrega a sí mismo)
          || (uid == request.auth.uid
            && request.auth.token.email == request.resource.data.dni + '@usuarios.territorio.app'
            && exists(/databases/$(database)/documents/invitaciones/$(request.resource.data.dni))
            && get(/databases/$(database)/documents/invitaciones/$(request.resource.data.dni)).data.cid == cid
            && request.resource.data.rol == get(/databases/$(database)/documents/invitaciones/$(request.resource.data.dni)).data.rol
            && request.resource.data.parentId == get(/databases/$(database)/documents/invitaciones/$(request.resource.data.dni)).data.parentId
            && request.resource.data.path == get(/databases/$(database)/documents/invitaciones/$(request.resource.data.dni)).data.path.concat([uid]))
          // un fiscal, colgado de quien lo cargó
          || (gestor()
            && request.resource.data.rol == 'fiscal'
            && request.resource.data.path == usuario(request.resource.data.parentId).path.concat([uid])
            && (esCabeza() || enMiEquipo(usuario(request.resource.data.parentId).path)))
        );
        allow update: if gestor() && (esCabeza() || (enMiEquipo(resource.data.path) && request.auth.uid != uid))
          && soloCambia(['nombre', 'tel', 'activo', 'circuito', 'domicilio']);
        // Quitar a alguien: una cabeza, o un superior de esa persona
        allow delete: if gestor() && request.auth.uid != uid && (esCabeza() || enMiEquipo(resource.data.path));
      }

      // Personas quitadas del equipo (para poder volver a sumarlas con el mismo DNI)
      match /bajas/{dni} {
        allow read, write: if gestor();
      }

      // ---------- Padrón (en baldes por los últimos 3 dígitos del DNI) ----------
      match /padron/{balde} {
        // los fiscales solo ven el resumen (nombres de escuelas), no los datos de los electores
        allow read: if gestor() || (miembro() && balde == 'resumen');
        allow write: if esCabeza();
      }

      // ---------- Personas (id = DNI: no puede haber dos con el mismo DNI) ----------
      match /personas/{dni} {
        // get de un DNI que no existe: se permite para saber que está libre
        allow get: if gestor() && (resource == null || esCabeza() || enMiEquipo(resource.data.path));
        allow list: if gestor() && (esCabeza() || enMiEquipo(resource.data.path));

        // Se carga a nombre propio o de alguien de mi equipo, con el path real de ese dueño
        allow create: if gestor()
          && request.resource.data.dni == dni
          && request.resource.data.path == usuario(request.resource.data.ownerId).path
          && (esCabeza() || enMiEquipo(request.resource.data.path))
          && request.resource.data.voto == false;

        allow update: if gestor() && (esCabeza() || enMiEquipo(resource.data.path)) && (
          // cambios comunes
          soloCambia(['estado', 'tel', 'domicilio', 'voto', 'votoAt', 'nota', 'tipo', 'revisar', 'actualizadoAt'])
          // transferencia a otro dueño dentro de mi equipo (las cabezas, a cualquiera)
          || (soloCambia(['ownerId', 'ownerNombre', 'path', 'actualizadoAt'])
            && request.resource.data.path == usuario(request.resource.data.ownerId).path
            && (esCabeza() || enMiEquipo(request.resource.data.path)))
        );
        allow delete: if gestor() && (esCabeza() || enMiEquipo(resource.data.path));
      }

      // ---------- Conflictos: intentos de cargar a alguien que ya es de otro ----------
      match /conflictos/{id} {
        allow read: if gestor() && (esCabeza() || enMiEquipo(resource.data.byPath));
        allow create: if gestor()
          && request.resource.data.byId == request.auth.uid
          && request.resource.data.byPath == yo().path
          && request.resource.data.estado == 'intento';
        allow update: if gestor() && (
          (resource.data.byId == request.auth.uid && soloCambia(['estado', 'motivo']) && request.resource.data.estado == 'reclamo')
          || (esCabeza() && soloCambia(['estado', 'resueltoPor']))
        );
      }

      // ---------- Ubicación del día de la elección: cada uno publica la suya; la ven sus superiores ----------
      match /ubicaciones/{uid} {
        allow read: if gestor() && (esCabeza() || enMiEquipo(resource.data.path));
        allow create, update: if miembro() && request.auth.uid == uid && request.resource.data.path == yo().path;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // ---------- Fiscalización: un documento por fiscal (id = uid del fiscal) ----------
      function rutaFiscal(fid) { return usuario(fid).path; }
      match /fiscalias/{fid} {
        allow read: if miembro() && (esCabeza() || enMiEquipo(resource.data.path));
        allow create, update: if miembro()
          && request.resource.data.path == rutaFiscal(fid)
          && (esCabeza() || enMiEquipo(rutaFiscal(fid)));
      }
      // Foto del acta (aparte, porque pesa)
      match /actas/{fid} {
        allow read: if miembro() && (esCabeza() || enMiEquipo(resource.data.path));
        allow create, update: if miembro()
          && request.resource.data.path == rutaFiscal(fid)
          && (esCabeza() || enMiEquipo(rutaFiscal(fid)));
      }
    }
  }
}
